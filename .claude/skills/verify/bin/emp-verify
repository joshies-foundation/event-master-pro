#!/usr/bin/env bash
# Lifecycle for one EventMaster Pro verification run.
# Usage: emp-verify <setup|up|reset|doctor|browser|login|down|status> [args]
# Every command except setup needs RUN_ID set. See ../SKILL.md.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO="$(cd "$SKILL_DIR/../../.." && pwd)"
PW_HOME="${EMP_VERIFY_PW_HOME:-$HOME/.cache/emp-verify/node}"
TMP_BASE="${TMPDIR:-/tmp}"
RUN_ROOT="${TMP_BASE%/}/emp-verify"
SEED_PASSWORD="password"

die() { echo "emp-verify: $*" >&2; exit 1; }

need_run() {
  [[ -n "${RUN_ID:-}" ]] || die "set RUN_ID first, e.g. export RUN_ID=\$(date +%Y%m%d-%H%M%S)"
  [[ "$RUN_ID" =~ ^[A-Za-z0-9._-]+$ ]] || die "RUN_ID may only contain letters, digits, . _ -"
  STATE="$RUN_ROOT/$RUN_ID"
  EVIDENCE="$REPO/tmp/verify/$RUN_ID"
}

supabase() { (cd "$REPO" && npx supabase "$@" </dev/null); }

ensure_stack() {
  local env
  if ! env="$(supabase status -o env 2>/dev/null)" || ! grep -q '^API_URL=' <<<"$env"; then
    echo "starting the local Supabase stack (npm run start-supabase)"
    supabase start >"$STATE/supabase-start.log" 2>&1 || { tail -20 "$STATE/supabase-start.log" >&2; die "supabase start failed"; }
    env="$(supabase status -o env 2>/dev/null)"
  fi
  grep -E '^(API_URL|ANON_KEY)=' <<<"$env" | tr -d '"' >"$STATE/supabase.env"
  echo "local Supabase: $(sed -n 's/^API_URL=//p' "$STATE/supabase.env")"
}

unload_app() { cmd_browser goto /manifest.webmanifest >/dev/null; }

stack_var() { sed -n "s/^$1=//p" "$STATE/supabase.env" 2>/dev/null; }

other_live_runs() {
  local d
  for d in "$RUN_ROOT"/*/; do
    [[ -d "$d" && "$(basename "$d")" != "$RUN_ID" ]] || continue
    alive "$d/ng.pid" || alive "$d/browser.pid" && basename "$d"
  done
  return 0
}

# Start a command in its own session so `down` can kill the whole process group.
spawn() { # spawn <logfile> <cmd...>; prints pid
  local log="$1"; shift
  nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or die "exec: $!"' "$@" >"$log" 2>&1 </dev/null &
  echo $!
}

alive() { [[ -f "$1" ]] && kill -0 "$(cat "$1")" 2>/dev/null; }

free_port() { # free_port <start>
  local p="$1"
  while lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1; do p=$((p + 1)); done
  echo "$p"
}

kill_group() { # kill_group <pidfile> <label>
  local pidfile="$1" label="$2"
  alive "$pidfile" || { rm -f "$pidfile"; return 0; }
  local pid; pid="$(cat "$pidfile")"
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
  kill -KILL -- "-$pid" 2>/dev/null || true
  rm -f "$pidfile"
  echo "stopped $label (pgid $pid)"
}

cmd_setup() {
  mkdir -p "$PW_HOME"
  if [[ ! -d "$PW_HOME/node_modules/playwright" ]]; then
    npm install --prefix "$PW_HOME" --no-audit --no-fund playwright@1 >/dev/null
  fi
  # webkit for iPhone profiles, chromium for Android profiles
  "$PW_HOME/node_modules/.bin/playwright" install webkit chromium >/dev/null
  echo "playwright $("$PW_HOME/node_modules/.bin/playwright" --version) ready in $PW_HOME"
}

cmd_up() {
  need_run
  mkdir -p "$STATE" "$EVIDENCE"
  ensure_stack
  if alive "$STATE/ng.pid"; then echo "dev server already up: $(cat "$STATE/url")"; return 0; fi
  [[ -d "$REPO/node_modules" ]] || die "node_modules missing; run npm install in $REPO"
  local port; port="$(free_port "${EMP_VERIFY_PORT:-4310}")"
  echo "http://127.0.0.1:$port" >"$STATE/url"
  (cd "$REPO" && spawn "$STATE/ng.log" npx ng serve --host 127.0.0.1 --port "$port" --no-hmr) >"$STATE/ng.pid"
  echo "starting ng serve on $port (log: $STATE/ng.log)"
  for _ in $(seq 1 180); do
    alive "$STATE/ng.pid" || { tail -40 "$STATE/ng.log" >&2; die "ng serve exited"; }
    if grep -q "Local:" "$STATE/ng.log" && curl -fsS "http://127.0.0.1:$port/" 2>/dev/null | grep -q "<joshies-root"; then
      echo "ready: http://127.0.0.1:$port"; return 0
    fi
    sleep 1
  done
  die "dev server not ready after 180s; see $STATE/ng.log"
}

cmd_browser() {
  need_run
  local sub="${1:-}"
  if [[ "$sub" == "stop" ]]; then
    kill_group "$STATE/browser.pid" browser
    [[ -f "$STATE/console.log" ]] && mkdir -p "$EVIDENCE" && cat "$STATE/console.log" >>"$EVIDENCE/console.log"
    rm -f "$STATE/browser_port" "$STATE/console.log"
    return 0
  fi
  if [[ "$sub" == "start" ]]; then
    [[ -d "$PW_HOME/node_modules/playwright" ]] || die "run '$0 setup' first"
    [[ -f "$STATE/url" ]] || die "no dev server for RUN_ID=$RUN_ID; run '$0 up' first"
    if alive "$STATE/browser.pid"; then echo "browser already up"; return 0; fi
    rm -f "$STATE/browser_port"
    STATE="$STATE" EVIDENCE="$EVIDENCE" PW_HOME="$PW_HOME" \
      spawn "$STATE/browser.log" node "$SKILL_DIR/bin/browser-server.mjs" >"$STATE/browser.pid"
    for _ in $(seq 1 60); do
      [[ -s "$STATE/browser_port" ]] && { cat "$STATE/browser.log"; return 0; }
      alive "$STATE/browser.pid" || break
      sleep 0.5
    done
    cat "$STATE/browser.log" >&2; die "browser server did not start"
  fi
  alive "$STATE/browser.pid" && [[ -s "$STATE/browser_port" ]] || die "no browser for RUN_ID=$RUN_ID; run '$0 browser start'"
  STATE="$STATE" node "$SKILL_DIR/bin/browser.mjs" "$@"
}

cmd_login() {
  need_run
  local user="${1:-colin}"
  unload_app
  cmd_browser eval "localStorage.clear(); sessionStorage.clear()" >/dev/null
  cmd_browser goto /auth/login
  cmd_browser fill --placeholder Username --value "$user"
  cmd_browser fill --placeholder Password --value "$SEED_PASSWORD"
  cmd_browser tap --role button --name "Log In"
  cmd_browser wait --url '/home'
  echo "logged in as $user"
}

cmd_reset() {
  need_run
  local others
  others="$(other_live_runs)"
  if [[ -n "$others" && "${1:-}" != "--force" ]]; then
    die "other runs share this database and are still up: $others. Wait for them, or pass --force."
  fi
  mkdir -p "$STATE"
  if alive "$STATE/browser.pid" && [[ -s "$STATE/browser_port" ]]; then
    unload_app
  fi
  echo "resetting the local database to supabase/seed.sql"
  supabase db reset >"$STATE/reset.log" 2>&1 || { tail -20 "$STATE/reset.log" >&2; die "supabase db reset failed"; }
  echo "reset done; run login again if a browser is up"
}

cmd_doctor() {
  need_run
  local ok=1 url api
  api="$(stack_var API_URL)"
  if [[ -n "$api" ]] && curl -fsS -o /dev/null "$api/auth/v1/health" -H "apikey: $(stack_var ANON_KEY)"; then
    echo "ok    local Supabase answers at $api"
  else echo "FAIL  local Supabase is not answering (run: emp-verify up)"; ok=0; fi

  local project functions applied local_migrations
  project="$(sed -n 's/^project_id = "\(.*\)"/\1/p' "$REPO/supabase/config.toml")"
  functions="$(docker inspect -f '{{range .Mounts}}{{.Destination}}{{"\n"}}{{end}}' "supabase_edge_runtime_$project" 2>/dev/null | grep '/supabase/functions$' || true)"
  if [[ "$functions" == "$REPO/supabase/functions" ]]; then echo "ok    the stack serves this checkout's edge functions"
  elif [[ -z "$functions" ]]; then echo "FAIL  the edge runtime is not running (run: npm run stop-supabase, then emp-verify up)"; ok=0
  else echo "FAIL  the stack was started from ${functions%/supabase/functions} (run npm run stop-supabase there, then emp-verify up here)"; ok=0; fi
  applied="$(docker exec "supabase_db_$project" psql -U postgres -At -c 'select version from supabase_migrations.schema_migrations order by 1' 2>/dev/null || true)"
  local_migrations="$(ls "$REPO/supabase/migrations" | sed 's/_.*//' | sort)"
  if [[ "$applied" == "$local_migrations" ]]; then echo "ok    the database has exactly this checkout's migrations"
  else echo "FAIL  the database migrations differ from this checkout's (run: emp-verify reset)"; ok=0; fi

  if alive "$STATE/ng.pid"; then
    url="$(cat "$STATE/url")"; local port="${url##*:}" owner
    owner="$(lsof -nP -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | head -1)"
    if [[ -n "$owner" && "$(ps -o pgid= -p "$owner" | tr -d ' ')" == "$(cat "$STATE/ng.pid")" ]]; then
      echo "ok    dev server pgid $(cat "$STATE/ng.pid") owns port $port"
    else echo "FAIL  port $port is not owned by this run's dev server"; ok=0; fi
    if curl -fsS "$url/" | grep -q "<title>EventMaster Pro</title>"; then echo "ok    $url serves EventMaster Pro"
    else echo "FAIL  $url does not serve EventMaster Pro"; ok=0; fi
  else echo "FAIL  no dev server for RUN_ID=$RUN_ID (run: emp-verify up)"; ok=0; fi

  if alive "$STATE/browser.pid" && [[ -s "$STATE/browser_port" ]]; then
    echo "ok    browser server pgid $(cat "$STATE/browser.pid")"
    local origins; origins="$(cmd_browser api)"
    if [[ -z "$origins" ]]; then echo "INFO  the app has not called Supabase yet (run: emp-verify login)"
    elif [[ "$origins" == "$api" ]]; then echo "ok    the app calls only $api"
    else echo "FAIL  the app called $(tr '\n' ' ' <<<"$origins")instead of only $api"; ok=0; fi
    cmd_browser whoami | sed 's/^/      /'
  else echo "INFO  no browser yet (run: emp-verify browser start)"; fi
  local others; others="$(other_live_runs)"
  [[ -z "$others" ]] || echo "INFO  other runs share this database: $others"
  echo "      evidence dir: $EVIDENCE"
  [[ $ok == 1 ]]
}

cmd_status() {
  local root="$RUN_ROOT"
  local found=0
  for d in "$root"/*/; do
    [[ -d "$d" ]] || continue
    local id; id="$(basename "$d")"; found=1
    printf '%s  ng:%s browser:%s  %s\n' "$id" \
      "$(alive "$d/ng.pid" && echo up || echo down)" \
      "$(alive "$d/browser.pid" && echo up || echo down)" "$(cat "$d/url" 2>/dev/null)"
  done
  [[ $found == 1 ]] || echo "no runs"
}

cmd_down() {
  need_run
  [[ -d "$STATE" ]] || { echo "nothing to stop for RUN_ID=$RUN_ID"; return 0; }
  cmd_browser stop
  kill_group "$STATE/ng.pid" "dev server"
  rm -rf "$STATE"
  echo "evidence kept: $EVIDENCE"
  [[ -d "$EVIDENCE" ]] && /bin/ls -1 "$EVIDENCE" | sed 's/^/  /' || true
}

case "${1:-}" in
  setup) cmd_setup ;;
  up) cmd_up ;;
  doctor) cmd_doctor ;;
  browser) shift; cmd_browser "$@" ;;
  login) shift; cmd_login "$@" ;;
  reset) shift; cmd_reset "$@" ;;
  status) cmd_status ;;
  down) cmd_down ;;
  *) sed -n '2,4p' "$0" | sed 's/^# //'; exit 2 ;;
esac
