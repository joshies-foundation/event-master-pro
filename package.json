{
  "name": "joshies",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=0.0.0.0",
    "build": "ng build",
    "prebuild": "node src/set-last-updated-date.mjs pre",
    "postbuild": "node src/set-last-updated-date.mjs post",
    "build-worker": "cf-wrangler build",
    "deploy": "npm run build && npm run build-worker && cf deploy --prebuilt",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write .",
    "postinstall": "patch-package",
    "lint": "ng lint",
    "lint-staged": "lint-staged",
    "generate-db-types": "supabase gen types typescript --local --schema public > src/app/shared/util/schema.ts && prettier --write src/app/shared/util/schema.ts",
    "start-supabase": "node supabase/scripts/local-stack.mjs start",
    "stop-supabase": "supabase stop",
    "reset-supabase": "node supabase/scripts/local-stack.mjs reset",
    "create-migration": "supabase db diff -f",
    "save-seed": "supabase db dump --data-only --local -x storage.buckets -x auth.audit_log_entries -x auth.sessions -x auth.refresh_tokens -x auth.mfa_amr_claims -x auth.one_time_tokens -x auth.flow_state -x public.user_notifications_subscription > supabase/seed.sql",
    "edge-function-logs": "supabase stack logs --service functions --follow --output-format text",
    "e2e": "playwright test"
  },
  "private": true,
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "singleQuote": true,
    "tailwindStylesheet": "./src/styles.css"
  },
  "pre-commit": [
    "lint-staged"
  ],
  "lint-staged": {
    "*.{ts,js,tsx,jsx,css,scss,sass,json,md,yml,yaml,html}": "prettier --write",
    "*.ts": "eslint --fix"
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "2.0.2",
    "@openng/optimus-ui-tailwindcss": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "chart.js": "^4.6.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.31",
    "quill": "2.0.2",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@ngx-env/builder": "^22.0.0",
    "@playwright/test": "^1.64.1",
    "angular-eslint": "^22.6.0",
    "cf": "1.0.0-beta.21",
    "eslint": "^10.13.0",
    "lint-staged": "^17.6.0",
    "postgres": "^3.4.9",
    "pre-commit": "^2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.122.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": "24",
    "npm": "11"
  },
  "type": "module"
}
